# Copy to .env and fill in your key.
#   cp .env.example .env
#
# Get a key from https://www.assemblyai.com/app/api-keys
# Without a key, Speakdown still runs — it starts in Demo Mode and replays a
# scripted dictation so you can explore the whole UI.

ASSEMBLYAI_API_KEY=

# The Dictation API endpoint. Correct as of September 2026; override only if
# AssemblyAI moves it. Note there is no unversioned alias for this path —
# /v1/transcribe/stream reaches the same handler.
SPEAKDOWN_API_URL=https://dictation.assemblyai.com/v1/transcribe/live

# Local server port
PORT=3000
