# Copy to .env and fill in your key.
#   cp .env.example .env
#
# Get a key from https://www.assemblyai.com/app/api-keys
# Without a key, Speakdown still runs — it starts in Demo Mode and replays a
# scripted dictation so you can explore the whole UI.

ASSEMBLYAI_API_KEY=

# The Sync (Dictation) endpoint and model. Defaults are correct as of Sept 2026;
# override only if AssemblyAI moves them.
SPEAKDOWN_API_URL=https://sync.assemblyai.com/transcribe
SPEAKDOWN_MODEL=universal-3-5-pro

# Local server port
PORT=3000
