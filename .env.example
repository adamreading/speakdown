# Copy to .env and fill in your key.
#   cp .env.example .env
#
# Get a key from https://www.assemblyai.com/app/api-keys
# Without a key, Speakdown still runs — it starts in Demo Mode and replays a
# scripted dictation so you can explore the whole UI.

ASSEMBLYAI_API_KEY=

# The Dictation API endpoint. Correct as of September 2026; override only if
# AssemblyAI moves it. Note there is no unversioned alias for this path —
# /v1/transcribe/stream reaches the same handler.
SPEAKDOWN_API_URL=https://dictation.assemblyai.com/v1/transcribe/live

# Local server port
PORT=3000

# ── Hosting it for other people ────────────────────────────────────────────
# Leave these unset for a local copy. On a shared host, set SPEAKDOWN_INVITE_ONLY=1
# and live dictation is unlocked only for browsers that arrive through a link from
#   node server/invite.js create --hours 72 --label "judges"
# Everyone else gets the full editor in Demo Mode. Expired invites clean
# themselves up. SPEAKDOWN_PUBLIC_URL is only used to print the full link.
#SPEAKDOWN_INVITE_ONLY=1
#SPEAKDOWN_PUBLIC_URL=https://example.com/speakdown/
# Cap on simultaneous upstream dictations (a ceiling on how fast credit can drain).
#SPEAKDOWN_MAX_LIVE_SESSIONS=6
